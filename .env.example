# Copy this file to .env and fill in your values.
# .env is gitignored - never commit it.

# ---- model / provider -----------------------------------------------------
# Required: model id passed to the gateway/provider
MODEL_ID=deepseek-chat

# Optional: Anthropic-compatible gateway base url (e.g. DeepSeek or LiteLLM)
# DeepSeek: https://api.deepseek.com/anthropic
ANTHROPIC_BASE_URL=

# Auth: depends on your gateway - set the one it requires.
# When ANTHROPIC_BASE_URL is set, ANTHROPIC_AUTH_TOKEN is removed automatically.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=

# Optional: workspace root (defaults to the current working directory)
# AGENT_WORKDIR=

# ---- permissions ----------------------------------------------------------
# allowlist: safe read-only commands run; writes/deletes/network/unknown ask
# strict:    every tool call asks
# auto:      no interactive approval (only for trusted environments)
PERMISSION_MODE=allowlist

# ---- feature switches (1/0) ----------------------------------------------
MEMORY_ENABLED=1
CRON_ENABLED=1
BACKGROUND_ENABLED=1
TEAMS_ENABLED=1
MCP_ENABLED=1
WORKFLOW_ENABLED=1

# ---- runtime limits -------------------------------------------------------
# Max output tokens per model call
MAX_TOKENS=8000
# Max tool-use turns per user turn (lead agent)
MAX_AGENT_TURNS=50
# Max turns for a subagent
SUBAGENT_MAX_TURNS=30
# Tool results kept verbatim before micro-compaction
KEEP_RECENT_TOOL_RESULTS=3
# Estimated-token threshold that triggers L4 summary compaction
CONTEXT_TOKEN_THRESHOLD=5000
# Total tool-result character budget before spilling the largest to disk
CONTEXT_CHAR_LIMIT=200000
# Single tool result cap (L0)
SINGLE_TOOL_RESULT_LIMIT=6000
# Tool results larger than this are persisted to .tool_outputs
TOOL_RESULT_PERSIST_LIMIT=30000
# Consecutive unmet-goal turns before the goal loop returns control
GOAL_BLOCK_CAP=8
# Retries for transient LLM errors
LLM_RETRIES=2

# ---- tracing (optional) ---------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agent-learning
